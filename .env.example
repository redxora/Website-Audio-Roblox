# WEB HOSTING & DOMAIN
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/gwBdp3KgKM


# DATABASE & STORAGE LOKAL (SQLite di VPS)
# Kosongkan untuk otomatis: <project>/data/app.db dan <project>/data/audio-files
SQLITE_DB_PATH=
AUDIO_STORAGE_DIR=


# ENKRIPSI API KEY ROBLOX (AES-256-GCM)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=your_64_character_hex_encryption_key


# DISCORD OAUTH2 (LOGIN RESMI DISCORD)
# Discord Dev: https://discord.com/developers/applications/<APP_ID>/oauth2/general
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
# DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback


# ISCORD BOT & GUILD SERVER (VERIFIKASI)
# Discord Bot: https://discord.com/developers/applications/<APP_ID>/bot
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_server_id


# MAPPING ROLE DISCORD KE PAKET LANGGANAN (WEEKLY, MONTHLY, LIFETIME)
DISCORD_ROLE_OWNER=
DISCORD_ROLE_ADMIN=
DISCORD_ROLE_STAFF=
DISCORD_ROLE_LIFETIME=
DISCORD_ROLE_MONTHLY=
DISCORD_ROLE_WEEKLY=
DISCORD_ROLE_BOOSTER=
DISCORD_ROLE_30DAYS=
DISCORD_ROLE_7DAYS=
DISCORD_ROLE_6MONTHS=
DISCORD_ROLE_MEMBER=
DISCORD_ROLE_PLAN_MAP={}


# BATASAN AUDIO & KUOTA
FREE_CONVERSIONS_PER_24H=2
NEXT_PUBLIC_MAX_AUDIO_DURATION_SECONDS=420
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=50
NEXT_PUBLIC_AUDIO_SAMPLE_RATE=22050


# ROBLOX ASSET SPOOFER & AUTO-UPLOAD (.ROBLOSECURITY / Open Cloud)
ROBLOX_COOKIE=


# PAYMENT GATEWAY (https://tako.id/api-docs)
# API Key & atur Callback URL di dashboard Tako: https://tako.id/me/api-keys
TAKO_API_KEY=your_tako_api_key
TAKO_CREATOR_USERNAME=your_tako_username
TAKO_CALLBACK_SECRET=your_tako_webhook_callback_secret
TAKO_USER_AGENT=cilaaa-audio-app/1.0


# DISCORD WEBHOOK LOG PEMBELIAN & AUDIT
DISCORD_PURCHASE_WEBHOOK_URL=https://discord.com/api/webhooks/...


# MANUAL TASK SECRET
# memicu endpoint maintenance (mis. /api/admin/cleanup).
TASK_SECRET=your_secure_task_secret_key

# INTERNAL WEBHOOK SECRET
# Dipakai endpoint sinkronisasi subscription (/api/subscriptions/sync).
INTERNAL_WEBHOOK_SECRET=your_internal_webhook_secret
